// Patch for ~/.openclaw/openclaw.json that turns the existing install into the
// Canvas assistant. Apply with:
//   openclaw config patch --file openclaw/config.patch.json5 --dry-run   # validate
//   openclaw config patch --file openclaw/config.patch.json5             # write
// Objects merge, arrays/scalars replace, null deletes. No secrets in here:
// TELEGRAM_BOT_TOKEN and NVIDIA_API_KEY come from ~/.openclaw/.env.
{
  gateway: { mode: "local", bind: "loopback" }, // existing token auth is kept
  // Fresh conversation after 30 idle minutes keeps prompts small and fast.
  session: { dmScope: "per-channel-peer", reset: { mode: "idle", idleMinutes: 30 } },

  env: { vars: { OLLAMA_API_KEY: "ollama-local" } }, // placeholder Ollama expects, not a secret

  models: {
    providers: {
      // Native Ollama API: no /v1, which breaks tool calling.
      ollama: { baseUrl: "http://127.0.0.1:11434" },
      // NVIDIA build.nvidia.com: free, no card, ~2 s per call, no rate limit hit in
      // testing (Groq's free tier, 8k tokens/min, broke after 1-2 questions).
      // Key: NVIDIA_API_KEY in ~/.openclaw/.env. Nemotron is in the bundled catalog;
      // gpt-oss-20b is registered here so it can be the fallback.
      nvidia: {
        baseUrl: "https://integrate.api.nvidia.com/v1",
        models: [{ id: "openai/gpt-oss-20b", name: "GPT-OSS 20B" }],
      },
      groq: null, // replaced by NVIDIA (no-op on a fresh install)
    },
  },

  agents: {
    defaults: {
      userTimezone: "America/New_York",
      models: {
        // 16k context fits the prompt plus tool results and uses ~2.5 GB less RAM than 32k.
        // The local model mostly runs the 8 AM brief, so unload it soon after.
        "ollama/qwen3:8b": { alias: "local", params: { num_ctx: 16384, keep_alive: "5m" } },
        "nvidia/nvidia/nemotron-3-super-120b-a12b": { alias: "cloud" },
        "nvidia/openai/gpt-oss-20b": { alias: "cloud-small" },
        "groq/openai/gpt-oss-120b": null, // replaced by NVIDIA
      },
    },
    entries: {
      main: {
        // Chat runs on NVIDIA's free API (Nemotron 3 Super 120B), falling back to
        // gpt-oss-20b on the same API. Never falls back to the local model: that
        // stalled replies for minutes and starved the Mac of RAM.
        // The 8 AM reminder pins ollama/qwen3:8b in openclaw/automations.sh.
        // /model local = private mode (on-device, ~2 min per reply).
        model: {
          primary: "nvidia/nvidia/nemotron-3-super-120b-a12b",
          fallbacks: ["nvidia/openai/gpt-oss-20b"],
        },
        // Only free models can be selected; blocks the paid Anthropic profile.
        modelPolicy: { allow: ["ollama/*", "nvidia/*"] },
        // No bundled skills (Notion, meme-maker, ClawHub…): smaller prompt, fewer ways to go wrong.
        skills: [],
        // Faster replies (and Qwen3 thinking doubled latency locally); /think re-enables it per chat.
        thinkingDefault: "off",
        // No 30-minute background heartbeat: it occupies the local model and the
        // Canvas reminders are explicit automations instead.
        heartbeat: { every: "0m" },
        // Leftover per-model entry for the old paid Anthropic setup.
        models: null,
      },
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: { source: "env", provider: "default", id: "TELEGRAM_BOT_TOKEN" },
      dmPolicy: "allowlist",
      allowFrom: ["YOUR_TELEGRAM_USER_ID"], // numeric ID from @userinfobot
      groupPolicy: "disabled",
      // No link previews: otherwise a prompt-injected URL in a reply (e.g. hidden in a
      // Canvas announcement) is fetched by Telegram's servers without any click.
      linkPreview: false,
    },
  },

  mcp: {
    servers: {
      canvas_lms: {
        transport: "stdio",
        command: "/ABSOLUTE/PATH/TO/Canvas_sync/canvas-mcp/.venv/bin/python",
        args: ["-m", "canvas_mcp.server"],
        cwd: "/ABSOLUTE/PATH/TO/Canvas_sync/canvas-mcp",
        connectionTimeoutMs: 90000, // default 30 s was exceeded once under memory pressure
        // Only our 8 tools, not the generic prompts_*/resources_* helpers.
        toolFilter: {
          include: ["list_courses", "upcoming", "missing", "assignment_details",
                    "announcements", "grades", "list_files", "read_file"],
        },
      },
    },
  },

  tools: {
    profile: "messaging",
    alsoAllow: ["canvas_lms__*"],
    // Expose tools directly. Tool Search hides them behind search/describe/call
    // meta-tools, which an 8B model fails to drive (3/3 failed calls in testing).
    toolSearch: false,
    deny: [
      "group:runtime", // exec, process, code_execution
      "group:fs", // read, write, edit, apply_patch
      "group:ui", // browser, screen, terminal, canvas panel
      "group:nodes", // computer control
      "group:automation", // cron/gateway tools (jobs are created from the CLI instead)
      "group:web", // fetched web pages are a prompt-injection vector
      "group:sessions", // session/conversation management, sub-agents
      // Already outside the messaging profile; denied again as defense in depth.
      // (group:openclaw covers built-in tools only, not our MCP tools.)
      "group:memory",
      "group:media",
      "group:agents",
      "group:openclaw",
      "presence",
      "intent",
      // Replies reach Telegram without these; `message` alone is ~3k tokens of schema.
      "message",
      "ask_user",
    ],
    // Redundant with the denies above; kept so a future profile change can't reopen them.
    exec: { security: "deny", ask: null },
    elevated: { enabled: false },
    sessions: { visibility: "agent" },
    agentToAgent: { enabled: false },
  },

  plugins: {
    // Only these plugins may load. Not device-pair (its /pair codes grant operator.admin),
    // document-extract (our server parses PDFs) or memory-core (no persistent memory needed).
    allow: ["telegram", "ollama", "nvidia"],
    entries: {
      browser: { enabled: false }, // redundant with plugins.allow; defense in depth
      // Leftovers from the original install (paid Anthropic model) and the Groq trial:
      anthropic: null,
      groq: null,
    },
  },
}
